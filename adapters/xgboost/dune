(library
 (name modelkit_xgboost)
 (public_name modelkit-xgboost)
 (modules modelkit_xgboost modelkit_xgboost_version modelkit_xgboost_io)
 (private_modules modelkit_xgboost_version modelkit_xgboost_io)
 (libraries modelkit xgboost yojson))

(rule
 (target modelkit_xgboost_version.ml)
 (action
  (write-file %{target} "let value = \"%{version:modelkit-xgboost}\"\n")))

(library
 (name xgboost_workflow_support)
 (wrapped false)
 (optional)
 (modules workflow_support)
 (libraries modelkit modelkit-xgboost alcotest)
 (foreign_stubs
  (language c)
  (names workflow_probe))
 (c_library_flags -ldl))

(test
 (name artifact_test)
 (modules artifact_test)
 (package modelkit-xgboost)
 (libraries modelkit modelkit-xgboost xgboost alcotest yojson)
 (action
  (setenv
   OMP_NUM_THREADS
   1
   (setenv
    OMP_THREAD_LIMIT
    1
    (run %{test})))))

