+let cmake_supported output =
+  let first = List.hd (String.split_on_char '\n' output) in
+  match List.filter (( <> ) "") (String.split_on_char ' ' first) with
+  | "cmake" :: "version" :: version :: _ -> (
+      match String.split_on_char '.' version with
+      | major :: minor :: _ -> (
+          match (int_of_string_opt major, int_of_string_opt minor) with
+          | Some major, Some minor -> major > 3 || (major = 3 && minor >= 18)
+          | _ -> false)
+      | _ -> false)
+  | _ -> false
+
+let select_cmake ~override ~which ~version =
+  let candidates =
+    match override with
+    | Some command -> [ command ]
+    | None -> [ "cmake3"; "cmake" ]
+  in
+  List.find_map
+    (fun name ->
+      Option.bind (which name) (fun command ->
+          Option.bind (version command) (fun output ->
+              if cmake_supported output then Some command else None)))
+    candidates
+
+let positive_jobs name value =
+  match int_of_string_opt (String.trim value) with
+  | Some n when n > 0 -> n
+  | _ -> invalid_arg (name ^ " must be a positive integer")
+
+let memory_jobs bytes =
+  let gib = 1_073_741_824L in
+  (* Reserve one GiB for the host and other build steps, then budget one GiB
+     per C++ compiler. This is a scheduling heuristic, not an OOM guarantee. *)
+  Int64.(to_int (max 1L (min 6L (div (sub bytes gib) gib))))
+
+let build_jobs ~cpus ~memory_bytes ~getenv =
+  let budget =
+    List.fold_left min (max 1 (min 6 cpus)) (List.map memory_jobs memory_bytes)
+  in
+  let limits =
+    List.filter_map
+      (fun name -> Option.map (positive_jobs name) (getenv name))
+      [ "XGBOOST_BUILD_JOBS"; "CMAKE_BUILD_PARALLEL_LEVEL"; "OPAMJOBS" ]
+  in
+  List.fold_left min budget limits
