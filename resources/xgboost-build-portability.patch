+let check label condition = if not condition then failwith label
+let gib n = Int64.mul (Int64.of_int n) 1_073_741_824L
+
+let jobs ?(memory = []) ?(env = []) cpus =
+  Build_policy.build_jobs ~cpus ~memory_bytes:memory ~getenv:(fun key ->
+      List.assoc_opt key env)
+
+let () =
+  List.iter
+    (fun version -> check version (Build_policy.cmake_supported version))
+    [
+      "cmake version 3.18.0";
+      "cmake version 3.31.6\nextra";
+      "cmake version 4.4.4";
+    ];
+  List.iter
+    (fun version -> check version (not (Build_policy.cmake_supported version)))
+    [ "cmake version 3.17.9"; "cmake version 2.8.12"; "garbage"; "" ];
+  check "host CPU cap" (jobs 255 = 6);
+  check "single CPU" (jobs 1 = 1);
+  check "2GiB cgroup" (jobs ~memory:[ gib 2 ] 255 = 1);
+  check "nested memory budgets" (jobs ~memory:[ gib 8; gib 3 ] 255 = 2);
+  check "explicit limit" (jobs ~env:[ ("XGBOOST_BUILD_JOBS", "2") ] 255 = 2);
+  check "caller and CMake limits"
+    (jobs ~env:[ ("OPAMJOBS", "2"); ("CMAKE_BUILD_PARALLEL_LEVEL", "1") ] 255
+    = 1);
+  check "memory still bounds explicit limits"
+    (jobs ~memory:[ gib 2 ] ~env:[ ("XGBOOST_BUILD_JOBS", "6") ] 255 = 1);
+  List.iter
+    (fun value ->
+      match jobs ~env:[ ("XGBOOST_BUILD_JOBS", value) ] 255 with
+      | _ -> failwith "invalid job limit accepted"
+      | exception Invalid_argument _ -> ())
+    [ ""; "0"; "-2"; "many" ];
+  let select ?override commands =
+    Build_policy.select_cmake ~override
+      ~which:(fun name ->
+        if List.mem_assoc name commands then Some name else None)
+      ~version:(fun name -> List.assoc_opt name commands)
+  in
+  check "cmake3 only"
+    (select [ ("cmake3", "cmake version 3.18.0") ] = Some "cmake3");
+  check "new cmake3 preferred over old cmake"
+    (select
+       [ ("cmake3", "cmake version 3.31.0"); ("cmake", "cmake version 3.17.0") ]
+    = Some "cmake3");
+  check "old cmake3 falls back to compatible cmake"
+    (select
+       [ ("cmake3", "cmake version 3.17.0"); ("cmake", "cmake version 4.0.0") ]
+    = Some "cmake");
+  check "explicit override"
+    (select ~override:"custom" [ ("custom", "cmake version 3.18.0") ]
+    = Some "custom");
+  check "invalid override does not silently fall back"
+    (select ~override:"absent" [ ("cmake", "cmake version 4.0.0") ] = None);
+  check "no compatible command"
+    (select [ ("cmake", "cmake version 3.17.0") ] = None)
