(library
 (name modelkit_xgboost)
 (public_name modelkit-xgboost)
 (modules
  modelkit_xgboost
  modelkit_xgboost_version
  modelkit_xgboost_io
  modelkit_xgboost_streaming_native)
 (private_modules
  modelkit_xgboost_version
  modelkit_xgboost_io
  modelkit_xgboost_streaming_native)
 (libraries
  modelkit
  xgboost
  xgboost.bindings
  ctypes
  ctypes-foreign
  integers
  yojson
  unix))

(rule
 (target modelkit_xgboost_version.ml)
 (action
  (write-file %{target} "let value = \"%{version:modelkit-xgboost}\"\n")))

(test
 (name deployment_worker)
 (modules deployment_worker)
 (package modelkit-xgboost)
 (libraries modelkit modelkit-xgboost yojson)
 (deps
  (source_tree ../../test/fixtures/xgboost/artifacts))
 (action
  (setenv
   OMP_NUM_THREADS
   1
   (setenv
    OMP_THREAD_LIMIT
    1
    (run
     %{test}
     ../../test/fixtures/xgboost/artifacts/3.0.4
     regression.metadata.json
     --auto-compat)))))

(test
 (name pipeline_artifact_test)
 (modules pipeline_artifact_test)
 (package modelkit-xgboost)
 (libraries modelkit modelkit-xgboost alcotest yojson unix)
 (deps
  deployment_worker.exe
  (source_tree ../../test/fixtures/xgboost/artifacts))
 (action
  (setenv
   MODELKIT_XGBOOST_DEPLOYMENT_WORKER
   %{dep:deployment_worker.exe}
   (setenv
    MODELKIT_XGBOOST_ARTIFACT_FIXTURES
    ../../test/fixtures/xgboost/artifacts
    (setenv
     OMP_NUM_THREADS
     1
     (setenv
      OMP_THREAD_LIMIT
      1
      (run %{test})))))))

