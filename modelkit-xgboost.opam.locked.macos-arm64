opam-version: "2.0"
name: "modelkit-xgboost"
version: "0.6.3"
synopsis: "CPU histogram-tree estimators with XGBoost for ModelKit"
description:
  "ModelKit XGBoost provides weighted CPU histogram-tree regression, external-memory regression from replayable batches, binary/multiclass classification, immutable specifications, checked float32 input conversion, native missing-value routing, allocation reports, schema-checked prediction, and trusted fitted-model persistence without adding XGBoost dependencies to ModelKit's portable core."
maintainer: "Asara developers <devs@asara.io>"
authors: "Asara"
license: "Apache-2.0"
tags: ["data-science" "machine-learning" "adapters" "xgboost"]
homepage: "https://github.com/asara-io/ModelKit"
bug-reports: "https://github.com/asara-io/ModelKit/issues"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "astring" {= "0.8.5" & with-test}
  "backoff" {= "0.1.1" & with-test}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-test}
  "cmdliner" {= "2.1.1" & with-test}
  "conf-c++" {= "1.0"}
  "conf-cmake" {= "1"}
  "conf-libffi" {= "2.0.0"}
  "conf-libxgboost" {= "1"}
  "conf-pkg-config" {= "4"}
  "cppo" {= "1.8.0" & with-test}
  "crunch" {= "4.1.0" & with-doc}
  "csexp" {= "1.5.2"}
  "ctypes" {= "0.24.0"}
  "ctypes-foreign" {= "0.24.0"}
  "domain-local-await" {= "1.0.1" & with-test}
  "domainslib" {= "0.5.2" & with-test}
  "dune" {= "3.23.1"}
  "dune-configurator" {= "3.23.1"}
  "fmt" {= "0.11.0" & with-test}
  "fpath" {= "0.7.3" & with-doc}
  "integers" {= "0.8.0"}
  "logs" {= "0.10.0" & with-test}
  "mdx" {= "2.7.0" & with-test}
  "modelkit" {= "0.6.3"}
  "modelkit-parallel" {= "0.6.3" & with-test}
  "multicore-magic" {= "2.3.2" & with-test}
  "ocaml" {= "5.4.1"}
  "ocaml-base-compiler" {= "5.4.1"}
  "ocaml-compiler" {= "5.4.1"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-syntax-shims" {= "1.0.0" & with-test}
  "ocaml-version" {= "4.1.1" & with-test}
  "ocamlbuild" {= "0.16.1" & with-test}
  "ocamlfind" {= "1.9.8" & with-test}
  "odoc" {= "3.2.1" & with-doc}
  "odoc-parser" {= "3.2.1" & with-doc}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-test}
  "result" {= "1.5" & with-test}
  "saturn" {= "1.0.0" & with-test}
  "seq" {= "base" & with-doc}
  "stdlib-shims" {= "0.3.0"}
  "thread-table" {= "1.0.0" & with-test}
  "topkg" {= "1.1.1" & with-test}
  "tyxml" {= "5.0.0" & with-doc}
  "uutf" {= "1.0.4" & with-test}
  "xgboost" {= "0.2.6"}
  "yojson" {= "3.0.0"}
]
available: os != "win32" & arch != "riscv64"
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/asara-io/ModelKit.git"
x-maintenance-intent: ["(latest)"]