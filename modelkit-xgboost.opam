# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.5.0"
synopsis: "CPU histogram-tree regression with XGBoost for ModelKit"
description:
  "ModelKit XGBoost provides weighted CPU histogram-tree regression, immutable specifications, checked float32 input conversion, native missing-value routing, allocation reports, and schema-checked pipeline prediction without adding XGBoost dependencies to ModelKit's portable core."
maintainer: ["Asara developers <devs@asara.io>"]
authors: ["Asara"]
license: "Apache-2.0"
tags: ["data-science" "machine-learning" "adapters" "xgboost"]
homepage: "https://github.com/asara-io/ModelKit"
bug-reports: "https://github.com/asara-io/ModelKit/issues"
depends: [
  "dune" {>= "3.23"}
  "ocaml" {>= "5.2"}
  "modelkit" {= version}
  "xgboost" {= "0.2.1"}
  "mdx" {with-test & >= "2.4.0"}
  "alcotest" {with-test & >= "1.9.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/asara-io/ModelKit.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32"
