+        let chunk = Bytes.create 4096 in
+        let rec loop () =
+          let size = input ic chunk 0 (Bytes.length chunk) in
+          if size > 0 then (
+            Buffer.add_subbytes buffer chunk 0 size;
+            loop ())
+        in
+        loop ();
+        Some (Buffer.contents buffer))
+  with Sys_error _ -> None
